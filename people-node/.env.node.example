# Single-server extra node. Copy to `.env.node` (gitignored). Never commit secrets.
# Join the live public v2 testnet by loading HTTPS /network (preferred) or by copying
# the public fields from https://node.peopleblockchain.network/network
# CHAIN_ID must be people-public-testnet-v2-2026-09-30 for that chain (not people-public-testnet).

CHAIN_ID=people-public-testnet-v2-2026-09-30
GENESIS_FAUCET_ADDRESS=
BOOTSTRAP_ADDRESS=

# Seed gossip (comma-separated). host:port or ws://host:port
# Railway HTTP-only is not a gossip seed — use a host that publishes GOSSIP_PORT.
BOOTSTRAP_PEERS=

# What other peers should dial back to THIS node (public IP or DNS).
# Example: ws://203.0.113.10:4002
PUBLIC_GOSSIP_URL=

PEER_ID=vps-node-1
HOST_HTTP_PORT=4001
HOST_GOSSIP_PORT=4002

# Follower: keep faucet disabled.
ALLOW_FAUCET=0

# Optional: after joinValidator, so this process can attest/propose
# VALIDATOR_ADDRESS=0x...
# VALIDATOR_PRIVATE_KEY=

# Coordinated approved security upgrade: set the SAME future height and allowlist
# on ALL peers only after reviewing the upgrade manifest/runbook.
# Omitting SECURITY_UPGRADE_HEIGHT keeps legacy consensus/economics.
# SECURITY_UPGRADE_HEIGHT=<approved future height>
# VALIDATOR_ALLOWLIST=0x...lowercase-approved-address...,0x...
# Empty allowlist is valid for a bootstrap-only network.
# See ../docs/AUDIT-CRITICAL-FIXES.md; never reset DATA_DIR to update configuration.

# Coordinated Consensus Upgrade #1 (docs/protocol-decisions/consensus-upgrade-1.md): the SAME
# future height on ALL peers. Omitting it keeps the legacy rules. Once a height has been used it
# is pinned in the node's own state: the node refuses to start if you later change or drop it.
# CONSENSUS_UPGRADE_1_HEIGHT=<approved future height>
