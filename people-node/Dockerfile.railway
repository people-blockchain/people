# Alias for dashboards that still set dockerfilePath=Dockerfile.railway.
# Canonical portable image: Dockerfile.node (same instructions).
# Not mainnet. Do not set ALLOW_DEV_ENDPOINTS.
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* ./
COPY apps ./apps
COPY packages ./packages
COPY turbo.json tsconfig.base.json ./
RUN npm ci
RUN npm run build

FROM node:22-alpine
WORKDIR /app
COPY --from=build /app /app
ENV NODE_ENV=production
ENV DATA_DIR=/data
ENV BIND_HOST=0.0.0.0
ENV PORT=4001
ENV GOSSIP_PORT=4002
EXPOSE 4001 4002
HEALTHCHECK --interval=15s --timeout=5s --start-period=40s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||4001)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["npm", "--workspace", "@people/node", "run", "start"]
