# Local / internal testnet only. Copy to `.env` and fill in. Never commit `.env`.
# Generate a testnet-only key, e.g.:
#   node scripts/print-testnet-keypair.mjs
DEV_FAUCET_PRIVATE_KEY=
CHAIN_ID=people-internal-testnet
# Optional minima in PPL. Unset = owner-approved defaults
# (tokenCreate 1.045005, nftMint 2.925, transfer 0.004875).
# TOKEN_CREATE_MIN_FEE=
# NFT_MINT_MIN_FEE=

# Extra node on a VPS: see docker-compose.node.yml and .env.node.example
# BOOTSTRAP_PEERS=seed.example:4002
# PUBLIC_GOSSIP_URL=ws://YOUR_PUBLIC_IP:4002

# Protocol v2: separate bootstrap identity; private key only on seed node.
BOOTSTRAP_ADDRESS=
BOOTSTRAP_PRIVATE_KEY=
