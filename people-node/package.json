{
  "name": "open-validator-network",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "turbo run test",
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@ovn/node --filter=@ovn/web",
    "start": "turbo run start --filter=@ovn/node --filter=@ovn/web",
    "dev:all": "turbo run dev --filter=@ovn/node --filter=@ovn/web --filter=@ovn/mobile-lite",
    "stop": "bash scripts/stop-dev.sh",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "ci:smoke": "bash scripts/ci-smoke.sh",
    "test:public-node": "node --test scripts/node-network.test.mjs && node --test scripts/deployment-config.test.mjs && node scripts/public-node-smoke.mjs"
