  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "tsx": "^4.23.1",
    "turbo": "^2.10.7",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "solc": "^0.8.28"
  },
  "overrides": {
    "tmp": "0.2.7",
    "brace-expansion": "^5.0.12",
    "nanoid": "^3.3.19"
  }
