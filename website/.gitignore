# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-artifacts

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# brand-asset generation scratch
/.og-work/
__pycache__/
test-results/
playwright-report/

# live e2e pass (website/e2e) — reports and screenshots of the run
/e2e/.live-*.json
/e2e/.auth/
/e2e/test-results/

/e2e/.shot*.mjs
