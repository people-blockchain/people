# Public website + partner portal (website/). Never commit real secrets.
# Copy to `.env.local` for local Next.js. Set the same names in Vercel (Production + Preview).

# --- Web3Auth wallet (Sapphire Mainnet in production) ---
# Production default Client ID is baked into src/lib/web3auth-config.ts (public).
# Override in Vercel Production if rotating keys:
# NEXT_PUBLIC_WEB3AUTH_CLIENT_ID=
# NEXT_PUBLIC_WEB3AUTH_NETWORK=sapphire_mainnet
# Local dev: use a separate Devnet project (localhost cannot whitelist on Mainnet).
# Server-side verifier allowlist (audit wallet-sessions #1 / recon R2). Comma-separated exact
# Web3Auth dashboard verifier strings. Unset ⇒ a name heuristic (google / email_passwordless)
# is used and a warning is logged; set the exact strings once observed in production to pin it.
# WEB3AUTH_ALLOWED_VERIFIERS=

# --- Partner auth (Auth.js / NextAuth v5) ---
# Generate with: `openssl rand -base64 32`
AUTH_SECRET=

# Dedicated secret for per-user wallet wrap keys. REQUIRED in production (audit M02-2, recon R1):
# there is no runtime fallback to AUTH_SECRET any more — a leaked AUTH_SECRET (which signs every
# session cookie) must never also derive the AES key for every wallet vault. If unset, the vault
# is treated as unconfigured and /api/wallet/vault* answers 503 {error:"not_configured"}.
# Generate with: `openssl rand -base64 32` (at least 32 bytes).
# AUTH_SECRET is still read, but only to decrypt-and-migrate legacy vaultVersion 1 rows.
PEOPLE_WALLET_VAULT_SECRET=

# Canonical origin for magic links and OAuth (Production).
# Google redirect: https://www.peopleblockchain.network/api/auth/callback/google
AUTH_URL=https://www.peopleblockchain.network
AUTH_TRUST_HOST=true

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend (https://resend.com). Domain must be verified for peopleblockchain.network.
AUTH_RESEND_KEY=

AUTH_EMAIL_FROM="People <noreply@peopleblockchain.network>"

# Neon Postgres (pooled on Vercel; unpooled for migrations/drizzle-kit if needed).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Optional read-only People's node HTTP API (no trailing slash).
# PEOPLE_NODE_URL=

# --- PPL community sale (multichain checkout) ---
# Transfer receivers (Tron USDT TRC-20, TON USDT jetton, Solana USDT/USDC). Empty = network shown as pending.
# SALE_RECEIVER_TRON=
# SALE_RECEIVER_TON=
# SALE_RECEIVER_SOLANA=
# EVM sale contracts (override src/data/ppl-sale-evm.json after owner deploy).
# SALE_CONTRACT_BSC=
# SALE_CONTRACT_BASE=
# SALE_CONTRACT_ETHEREUM=
# SALE_CONTRACT_POLYGON=
# Cron secret for POST /api/sale/watch (payment watchers).
# SALE_CRON_SECRET=
# Server key that delivers PPL on People after confirmed payment (never commit).
# SALE_DELIVERY_PRIVATE_KEY=
# SALE_RPC_BSC=  SALE_RPC_BASE=  SALE_RPC_ETHEREUM=  SALE_RPC_POLYGON=
# SALE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- Public site / factory / wallet ---
# Built-in default node: https://node.peopleblockchain.network (override below if needed).
# Server-only RPC (same-origin proxy at /api/network). Prefer this over a public RPC URL.
# PEOPLE_RPC_URL=

# Explorer connects directly to the node WebSocket (Vercel does not proxy it).
# Defaults to PEOPLE_RPC_URL with ws/wss and /ws. Public URL, no credentials.
# PEOPLE_WS_URL=wss://node.peopleblockchain.network/ws

# Public chain backend: default `cosmos-evm` (operator JSON-RPC + deployed contracts).
# Rollback for local people-node stack: `NEXT_PUBLIC_CHAIN=people-node`
# NEXT_PUBLIC_CHAIN=cosmos-evm

# Cosmos EVM JSON-RPC (browser uses same-origin /api/evm/rpc; server uses EVM_RPC_URL).
# EVM_RPC_URL=https://node.peopleblockchain.network/rpc
# Explorer EVM subscription URL; default: EVM RPC host with /ws and ws/wss.
# Public endpoint only: no credentials, query strings or fragments.
# EVM_WS_URL=wss://node.peopleblockchain.network/ws
# NEXT_PUBLIC_EVM_RPC_URL=https://node.peopleblockchain.network/rpc
# EVM_FAUCET_URL=https://node.peopleblockchain.network/faucet

# Optional: server wallet that sends founder demo-token packs (100 × 6 ERC-20 on 97401). Unset = feature waits.
# FOUNDERS_AIRDROP_PRIVATE_KEY=

# WalletConnect project id (optional; enables WalletConnect button when set).
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Wallet address scheme: unset|false = legacy sha256 (prod default). true|evm = keccak. auto = eth_chainId via /api/network/rpc.
# NEXT_PUBLIC_EVM_CANONICAL_ADDRESSES=

# Optional chain id label (default people-public-testnet-v2-2026-09-30).
# NEXT_PUBLIC_CHAIN_ID=

# Public /docs node quick-start (defaults are baked in; override after a new GHCR digest).
# PUBLIC_NODE_IMAGE=ghcr.io/rednaxelavoroge/people-node@sha256:...
# PUBLIC_NODE_NETWORK_URL=https://node.peopleblockchain.network/network

# Owner-approved public PPL fees (defaults if unset):
# transfer 0.004875, tokenCreate 1.045005, nftMint 2.925
# contract gas 8.7e-7 PPL/gas (protocol constant)
# NEXT_PUBLIC_TOKEN_CREATE_FEE_PPL=
# NEXT_PUBLIC_NFT_MINT_FEE_PPL=

# Server-only LLM for /create/contract template selection. Never commit the key.
# CONTRACT_AI_API_KEY=
# CONTRACT_AI_BASE_URL=https://api.openai.com/v1
# CONTRACT_AI_MODEL=gpt-4o-mini
# CONTRACT_AI_FREEFORM=0

# --- Token/NFT media (IPFS via Pinata) + AI icon generation ---
# Pinata JWT for pinning uploads (https://app.pinata.cloud/developers/api-keys).
# NFT video (MP4/WebM) additionally needs a key with the Pinata v3 Files scopes: create signed
# upload URLs, read files and delete files, plus pinFileToIPFS. Without them images and SVG still
# work and video shows "video storage unavailable". No other variable is needed.
# PINATA_JWT=

# Primary (free): Cloudflare Workers AI FLUX.1 schnell — 10k Neurons/day on Workers Free, no card required.
# https://dash.cloudflare.com/ → Workers & Pages → Workers AI (see docs for API token).
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# Keyless fallback: legacy Pollinations image API (slow ~15s between images; set 0 to disable).
# ICON_GEN_POLLINATIONS_FALLBACK=1

# Optional paid fallback only if you already have Together credits (not required).
# TOGETHER_API_KEY=

# Optional: paid icon generations after daily free quota (PPL transfer recipient on-chain).
# FACTORY_ICON_FEE_RECIPIENT=

# Public paid fee per generation batch (default 0.1 PPL).
# NEXT_PUBLIC_ICON_GEN_FEE_PPL=

# Optional global daily cap for generation batches (default 2000).
# ICON_GEN_GLOBAL_DAILY_CAP=

# Audit api-cron M2: paid icon generations accept a payment tx only if the node marks it
# finalized and it is recent. These tune those gates (defaults: 30 min age, 1 confirmation).
# ICON_GEN_PAYMENT_TX_MAX_AGE_MS=1800000
# ICON_GEN_PAYMENT_MIN_CONFIRMATIONS=1

# Optional Cloudflare Turnstile (https://dash.cloudflare.com/).
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional custom IPFS gateway base (default https://gateway.pinata.cloud/ipfs).
# Used for HTTPS preview links and for the ranged read that validates an uploaded video; point it
# at a dedicated gateway if the public one refuses ranged reads.
# IPFS_GATEWAY_URL=

# --- Admin access (/discover/stats, /admin/bugs, founders admin routes, /api/bugs/admin) ---
# Primary allowlist (audit api-cron M1): comma-separated stable Auth.js user ids
# (session.user.id, e.g. from /api/auth/session). Preferred over email — email is not a stable
# identity and a Web3Auth login could otherwise attach to an admin account by email.
# DISCOVER_ADMIN_USER_IDS=
# Legacy allowlist: comma-separated admin emails. Kept as a migration fallback only, and only
# for sessions that signed in through Google (whose profile() rejects an unverified email).
# A magic-link or Web3Auth session carrying an admin email is NOT treated as admin any more.
# Opt-in only: with both lists empty nobody is an admin.
# DISCOVER_ADMIN_EMAILS=

# --- Million founders (/founders) verification ---
# Phone numbers are stored as salted hashes only. Generate: openssl rand -base64 32
# FOUNDERS_PHONE_HASH_SALT=
# @PeopleVerifyBot — server-only; webhook secret is derived in code (sha256 token, first 32 hex).
# Register webhook: node scripts/telegram-set-webhook.mjs (see script header).
# TELEGRAM_VERIFY_BOT_TOKEN=
# Level 2: World ID 4.0 (https://docs.world.org/world-id/quick-start/installation)
# Set to true to show World ID verification UI on /founders (default off).
# NEXT_PUBLIC_FOUNDERS_WORLD_ID_UI_ENABLED=true
# FOUNDERS_WORLD_ID_APP_ID=
# FOUNDERS_WORLD_ID_RP_ID=
# FOUNDERS_WORLD_ID_SIGNING_KEY=
# Optional action scope (default founders-level-2)
# FOUNDERS_WORLD_ID_ACTION=founders-level-2
# Level 2 (alt): Human Passport Stamps API v2 — https://developer.passport.xyz
# FOUNDERS_HUMAN_PASSPORT_API_KEY=
# FOUNDERS_HUMAN_PASSPORT_SCORER_ID=
# Optional minimum score (default 20, aligned with Passport recommendation)
# FOUNDERS_HUMAN_PASSPORT_MIN_SCORE=20

# --- Bug bounty button (floating "beetle" button, /api/bugs) ---
# Reuses TELEGRAM_VERIFY_BOT_TOKEN above; set a chat id to get a Telegram alert per report.
# Store-only (no error) when either is unset.
# SECURITY (audit api-cron L2): this is also the owner registration for the @PeopleVerifyBot
# support flow. When it is unset and no owner has claimed the bot yet, whoever currently owns
# OWNER_TELEGRAM_USERNAME can become the owner with a plain /start — and a Telegram username can
# be released and re-squatted. The owner receives every report (including reporters' emails) and
# can award reward points. Set this explicitly in production; once set (or once claimed) later
# claims are refused.
# BUG_REPORTS_TELEGRAM_CHAT_ID=
# "Support" link in the navbar + footer; hidden entirely when unset.
# NEXT_PUBLIC_SUPPORT_TG_URL=

# --- Cron / bot maintenance secrets ---
# Bearer secret for the Vercel cron routes (e.g. /api/telegram/daily-summary). Fail closed.
# CRON_SECRET=
# Audit api-cron L4: dedicated secret for POST /api/telegram/bot-profile (rewrites the bot's
# name/description/commands). Kept separate from CRON_SECRET so a leaked cron secret cannot
# rewrite the bot. Falls back to CRON_SECRET only when this is unset (documented migration path);
# set it in production. Fail closed when neither is set.
# TELEGRAM_BOT_PROFILE_SECRET=
